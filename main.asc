#include "acl/acl.h"
#include <stdint.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <chrono>
#include <vector>

// One independently queued stream per logical worker.  These are scheduler
// workers, NOT assertions of affinity to six physical AICPU cores.
struct BenchArgs { uint32_t groups; uint32_t seed; uint32_t mode; uint32_t report; };
extern __global__ __aicpu__ uint32_t blake3_bench(void *args);
static volatile sig_atomic_t stopping = 0;
static void sigint_handler(int) { stopping = 1; }
static unsigned parse(const char *s, unsigned min, unsigned max, const char *name) {
    char *end = nullptr;
    unsigned long val = strtoul(s, &end, 10);
    if (!s[0] || *end || val < min || val > max) {
        fprintf(stderr, "Invalid %s: %s (allowed %u..%u)\n", name, s, min, max);
        exit(2);
    }
    return (unsigned)val;
}
static double seconds(std::chrono::steady_clock::time_point a,
                      std::chrono::steady_clock::time_point b) {
    return std::chrono::duration<double>(b - a).count();
}

int main(int argc, char **argv) {
    const unsigned workers = argc > 1 ? parse(argv[1],1,32,"workers") : 6;
    const unsigned groups = argc > 2 ? parse(argv[2],1,1000000,"groups") : 1024;
    const unsigned device = argc > 3 ? parse(argv[3],0,255,"device") : 0;
    const unsigned queue_depth = argc > 4 ? parse(argv[4],1,64,"queue_depth") : 4;
    const unsigned windows = argc > 5 ? parse(argv[5],0,10000000,"windows") : 0;
    signal(SIGINT, sigint_handler);

    aclError err = aclInit(nullptr);
    if (err != ACL_SUCCESS) { fprintf(stderr,"aclInit: %d\n",(int)err); return 1; }
    err = aclrtSetDevice(device);
    if (err != ACL_SUCCESS) { fprintf(stderr,"aclrtSetDevice: %d\n",(int)err); aclFinalize(); return 1; }
    int status = 0;
    std::vector<aclrtStream> worker_stream(workers,nullptr);
    unsigned created = 0;
    for (; created < workers; ++created) {
        err = aclrtCreateStream(&worker_stream[created]);
        if (err != ACL_SUCCESS) { fprintf(stderr,"aclrtCreateStream worker %u: %d\n",created,(int)err); status=1; break; }
    }
    uint64_t total_hashes = 0;
    if (!status) {
        printf("AICPU BLAKE3: %u logical workers, %u NEON-4 groups/task, queue depth %u, device %u\n",
               workers,groups,queue_depth,device);
        printf("Each task hashes %u independent 64-byte messages. Ctrl+C drains queued tasks.\n",groups*4u);
        fflush(stdout);
        BenchArgs self = {1,0,1,0};
        blake3_bench<<<1,nullptr,worker_stream[0]>>>(&self,sizeof(self));
        err=aclrtSynchronizeStream(worker_stream[0]);
        if(err!=ACL_SUCCESS) {fprintf(stderr,"Self-test sync failed: %d; NO BENCHMARK RESULTS VALID\n",(int)err);status=1;}
        if(!status) {
            printf("Self-test launch synchronized (confirm [AICPU] PASS above).\n");
            const auto global_start = std::chrono::steady_clock::now();
            unsigned long long completed=0;
            while (!stopping && !status && (windows==0 || completed<windows)) {
                const auto start = std::chrono::steady_clock::now();
                // Submit work across all workers before any stream is synchronized.
                // Each stream gets queue_depth independent kernels, executing in order.
                for (unsigned depth=0; depth<queue_depth && !stopping; ++depth) {
                    for (unsigned w=0; w<workers; ++w) {
                        const uint64_t task_id = (completed * (uint64_t)queue_depth + depth) * workers + w;
                        BenchArgs args={groups,(uint32_t)(task_id * groups * 4ull),0,0};
                        blake3_bench<<<1,nullptr,worker_stream[w]>>>(&args,sizeof(args));
                    }
                }
                // Even when Ctrl+C interrupts submission, finish all streams before teardown.
                for (unsigned w=0; w<workers; ++w) {
                    err = aclrtSynchronizeStream(worker_stream[w]);
                    if(err!=ACL_SUCCESS) { fprintf(stderr,"sync worker %u: %d\n",w,(int)err);status=1; }
                }
                if (status) break;
                // If interrupted mid-window, count only full windows for reliable accounting.
                if (stopping) break;
                ++completed;
                const uint64_t hashes_per_window = (uint64_t)workers * queue_depth * groups * 4ull;
                total_hashes += hashes_per_window;
                const double dt=seconds(start,std::chrono::steady_clock::now());
                const double elapsed=seconds(global_start,std::chrono::steady_clock::now());
                if(completed==1 || completed%16==0 || (windows && completed==windows)) {
                    printf("windows=%llu hashes=%llu window_hash/s=%.2f M overall_hash/s=%.2f M elapsed=%.2f s\n",
                           completed,(unsigned long long)total_hashes,hashes_per_window/dt/1e6,
                           total_hashes/elapsed/1e6,elapsed);
                    fflush(stdout);
                }
            }
            const double elapsed=seconds(global_start,std::chrono::steady_clock::now());
            printf("Stopped: full windows=%llu valid-accounted hashes=%llu avg=%.3f Mhash/s, elapsed=%.3f s\n",
                   completed,(unsigned long long)total_hashes,elapsed>0?total_hashes/elapsed/1e6:0,elapsed);
        }
    }
    for(unsigned w=0; w<created; ++w) if(aclrtDestroyStream(worker_stream[w])!=ACL_SUCCESS) status=1;
    if(aclrtResetDevice(device)!=ACL_SUCCESS) status=1;
    if(aclFinalize()!=ACL_SUCCESS) status=1;
    return status;
}
